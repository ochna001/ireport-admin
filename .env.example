# iReport Admin Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Anon key (if not using service role)
# SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps / Places API (for map picker and nearby services)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# AI worker authentication (required when AI_WORKER_API_KEY is enabled)
# AI_WORKER_API_KEY=your-ai-worker-api-key-here

# AI dispatch rollout. Keep shadow until evaluation and dispatcher sign-off pass.
VITE_AI_DISPATCH_MODE=shadow
VITE_AI_SHADOW_REVEAL=false

# Note: Keep this file secure and never commit .env to version control
